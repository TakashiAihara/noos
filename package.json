{
  "name": "noos",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/meguru/*",
      "apps/yomu/*",
      "apps/yomu/services/*",
      "apps/suru/*",
      "apps/suru/services/*",
      "packages/common/*",
      "packages/yomu/*",
      "packages/suru/common/*",
      "tooling/*"
    ],
    "catalog": {
      "@biomejs/biome": "^1.9.4",
      "@tsconfig/strictest": "2.0.5",
      "@types/node": "^22.14.0",
      "@vitest/coverage-v8": "^3.1.1",
      "fix-esm-import-path": "^1.10.1",
      "sort-package-json": "^3.0.0",
      "ts-node": "^10.9.2",
      "tsc-alias": "^1.8.13",
      "tsup": "^8.4.0",
      "tsx": "^4.19.3",
      "typescript": "^5.8.3",
      "vite-tsconfig-paths": "^5.1.4",
      "vitest": "^3.1.1"
    }
  },
  "license": "ISC",
  "author": "TakashiAihara",
  "scripts": {
    "build": "turbo build",
    "meguru:dev": "turbo run dev --filter=@meguru/*",
    "yomu:dev": "turbo run dev --filter=@yomu/*",
    "suru:dev": "turbo run dev --filter=@suru/*",
    "all:dev": "turbo run dev",
    "common:build": "turbo run build --filter=@common/*",
    "check": "biome check --verbose --log-level=debug",
    "check:ci": "bun run check --reporter=github",
    "check:staged": "bun run check --staged --no-errors-on-unmatched",
    "check:unsafe": "bun run check --unsafe",
    "check:unsafe:write": "bun run check:unsafe --write",
    "check:write": "biome check --write",
    "clean": "bun run --filter '*' clean && git clean -dfx .turbo node_modules",
    "db:base": "bun run --filter '@packages/db'",
    "db:format": "bun run db:base db:format",
    "db:generate": "bun run db:base db:generate",
    "db:migrate": "bun run db:base db:migrate",
    "db:migrate:deploy": "bun run db:base db:migrate:deploy",
    "db:migrate:rollback": "bun run db:base db:migrate:rollback",
    "db:migrate:status": "bun run db:base db:migrate:status",
    "db:pull": "bun run db:base db:pull",
    "db:push": "bun run db:base db:push",
    "db:seed": "bun run db:base db:seed",
    "db:studio": "bun run db:base db:studio",
    "doc:arch:generate": "d2 docs/architecture.d2 docs/architecture.svg",
    "doc:arch:watch": "bun run doc:arch:generate --watch",
    "docker-compose:all": "docker compose --profile all",
    "docker-compose:all:dev:up": "bun run docker-compose:all -f docker-compose.yml up",
    "docker-compose:all:dev:up:build": "bun run docker-compose:all:dev:up --build",
    "docker-compose:all:prod:up": "bun run docker-compose:all -f docker-compose.yml -f docker-compose.production.yml up --build",
    "docker-compose:all:prod:up:build": "bun run docker-compose:all:prod:up --build",
    "docker-compose:db": "docker compose --profile db",
    "docker-compose:db:dev:up": "bun run docker-compose:db -f docker-compose.yml up",
    "docker-compose:db:dev:up:build": "bun run docker-compose:db:dev:up --build",
    "docker-compose:db:prod:up": "bun run docker-compose:db -f docker-compose.yml -f docker-compose.production.yml up",
    "docker-compose:db:prod:up:build": "bun run docker-compose:db:prod:up --build",
    "format": "bun run format:write && bun run format:packages && bun run --filter '*' format",
    "format:check": "biome format",
    "format:docker-compose": "dclint . --fix",
    "format:packages": "sort-package-json 'apps/**/package.json' 'packages/**/package.json' 'tooling/**/package.json' -i '**/node_modules/**'",
    "format:write": "biome format --write",
    "lint:check": "biome lint",
    "lint:write": "biome lint --write",
    "start": "turbo start",
    "start:debug": "turbo start:debug",
    "start:dev": "turbo start:dev",
    "start:dev:watch": "turbo watch start:dev",
    "start:prod": "turbo start:prod",
    "test": "turbo test",
    "test:all": "turbo test:all",
    "test:benchmark": "turbo test:benchmark",
    "test:cov": "turbo test:cov",
    "test:integration": "turbo test:integration",
    "test:snapshot:update": "turbo test:snapshot:update",
    "test:unit": "turbo test:unit",
    "test:watch": "turbo test:watch",
    "turbo:completion": "turbo completion",
    "turbo:init": "bun run turbo:login && bun run turbo:link",
    "turbo:link": "turbo link",
    "turbo:login": "turbo login",
    "turbo:ls": "turbo ls",
    "turbo:prune": "turbo prune",
    "turbo:scan": "turbo scan",
    "type:check": "turbo type:check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "dclint": "^2.2.2",
    "sort-package-json": "catalog:",
    "turbo": "^2.5.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@nestjs/core",
    "@prisma/client",
    "@prisma/engines",
    "@swc/core",
    "esbuild",
    "prisma"
  ]
}
